{
  "rules": {
    ".read": false,
    ".write": false,
    "care_live": {
      "presence": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'emoji', 'color', 'away', 'since'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20" },
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "color": { ".validate": "newData.isString() && newData.val().length <= 9" },
          "away": { ".validate": "newData.isBoolean()" },
          "since": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "typing": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['scope', 't'])",
          "scope": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "lobby": {
        ".read": "auth != null",
        "$msg": {
          ".write": "auth != null && (data.exists() ? data.child('from').val() === auth.uid : newData.child('from').val() === auth.uid)",
          ".validate": "newData.hasChildren(['from', 'name', 'emoji', 'color', 'to', 'text', 'kind', 't'])",
          "from": { ".validate": "newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "color": { ".validate": "newData.isString() && newData.val().length <= 9" },
          "to": { ".validate": "newData.val() === 'lobby'" },
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
          "kind": { ".validate": "newData.val() === 'text' || newData.val() === 'wave'" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "dm": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$msg": {
            ".write": "auth != null && (data.exists() ? data.child('from').val() === auth.uid : newData.child('from').val() === auth.uid)",
            ".validate": "newData.hasChildren(['from', 'name', 'emoji', 'color', 'to', 'text', 'kind', 't'])",
            "from": { ".validate": "newData.val() === auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 9" },
            "to": { ".validate": "newData.val() === $uid" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
            "kind": { ".validate": "newData.val() === 'text' || newData.val() === 'wave'" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
